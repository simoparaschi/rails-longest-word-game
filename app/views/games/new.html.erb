<h1>New game</h1>

<!-- Word generator -->
<div class="flex">
  <% @letters.each do |letter| %>
  <p><%= letter %></p>
  <% end %>
</div>

<!-- Form -->
<p>What is the longest word?</p>
<form action="/score" method="post" data-turbo="false">
  <input type="text" name="word" class="">
  <input type="submit" value="Play" class="">

  <!-- Hidden field to pass @letters -->
   <%= hidden_field_tag :letters, @letters.join("") %>

  <!-- CSFR token -->
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
</form>
